{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "../src/features/coach/**/*.ts",
    "../src/domain/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/**/*.test.ts",
    "../src/features/coach/api.ts",
    "../src/features/coach/sync.ts",
    "../src/features/coach/snapshot.ts",
    "../src/features/coach/useCoachSync.ts"
  ]
}