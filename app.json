{
  "expo": {
    "name": "PLATE",
    "slug": "plate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.plate.pfc",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1712",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "体重と体脂肪率を読み込んで、体重の推移と目標の補正に使います。読み込むだけで、書き込みはしません。",
          "NSHealthUpdateUsageDescription": "PLATE は、ヘルスケアへの書き込みをしません。",
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1712",
          "image": "./assets/splash-login.png",
          "resizeMode": "cover",
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#1F1712"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "食事の写真を撮って、食べたものの栄養を推定するために、カメラを使います。",
          "photosPermission": "食事の写真を選んで、食べたものの栄養を推定するために、写真を使います。",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "plate",
    "experiments": {
      "typedRoutes": true
    }
  }
}