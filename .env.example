# Supabase（ログイン・バックアップ・AI入力）
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# AI入力の Edge Function（未設定なら成分表との照合で推定する）
EXPO_PUBLIC_AI_ENDPOINT=
# RevenueCat（iOS の公開SDKキー。未設定なら課金は無効で、4週間の無料体験だけ端末内で動く）
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# 利用規約・プライバシーポリシーのURL（web/legal.html を公開したもの。#terms・#privacy を付ける）
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# 計測（README_launch 5章）。サービスが決まるまでは未設定でよい（開発中はconsole.logだけ）
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
